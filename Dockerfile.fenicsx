# Dockerfile for FEniCSx (DOLFINx) in Duality-Zero

# Use a recent Ubuntu image as a base
FROM ubuntu:22.04

# Set environment variables for FEniCSx installation
ENV DEBIAN_FRONTEND=noninteractive

# Update package lists and install basic dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    cmake \
    git \
    wget \
    python3 \
    python3-pip \
    python3-dev \
    libopenmpi-dev \
    openmpi-bin \
    gfortran \
    libgfortran-11-dev \
    flex \
    patchelf \
    && rm -rf /var/lib/apt/lists/*

# Install DOLFINx (FEniCSx Python bindings)
# Use pip to install the latest stable version.
# petsc4py and slepc4py will bring their own PETSc/SLEPc installations.
ENV PETSC_CONFIGURE_OPTIONS="--download-fblaslapack --download-metis --download-ptscotch --download-parmetis --download-suitesparse --download-cholesky --download-spai --download-mumps --download-scalapack --download-hypre --download-superlu --download-superlu_dist --download-blacs --download-ml --download-ptscotch --download-hypre --with-debugging=0 --download-cmake --download-bison"
# Install petsc4py first
RUN python3 -m pip install --no-cache-dir mpi4py petsc4py

# Install slepc4py and then fenics-dolfinx
# We need to find where petsc4py installs PETSc, then set PETSC_DIR/SLEPC_DIR for slepc4py.
# This requires running a shell command in the build context.
RUN PETSC_DIR_LOC=$(python3 -c "import petsc4py; import os; print(os.path.join(os.path.dirname(petsc4py.__file__), 'lib', 'petsc'))") && \
    export PETSC_DIR=$PETSC_DIR_LOC && \
    export SLEPC_DIR=$PETSC_DIR_LOC && \
    python3 -m pip install --no-cache-dir \
    slepc4py \
    fenics-dolfinx==0.7.0 \
    meshio \
    gmsh \
    matplotlib \
    numpy

# Set a working directory inside the container
WORKDIR /app

# Command to run when the container starts (can be overridden)
CMD ["/bin/bash"]

# Add a note on how to build this image:
# docker build -t duality-fenicsx .
#
# How to run:
# docker run -ti --rm -v /Volumes/dual/DUALITY-ZERO-V2:/app duality-fenicsx /bin/bash

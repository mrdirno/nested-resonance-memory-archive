set_global_assignment -name FAMILY "Cyclone V"
set_global_assignment -name DEVICE 5CSEBA6U23I7
set_global_assignment -name TOP_LEVEL_ENTITY blink
set_global_assignment -name ORIGINAL_QUARTUS_VERSION 24.1.0
set_global_assignment -name PROJECT_CREATION_TIME_DATE "11/27/2025 04:30:00"

# Pin Assignments
set_location_assignment PIN_V11 -to CLOCK_50
set_location_assignment PIN_W15 -to LED

# Add Verilog Files
set_global_assignment -name VERILOG_FILE blink.v
set_global_assignment -name LAST_QUARTUS_VERSION "24.1std.0 Lite Edition"
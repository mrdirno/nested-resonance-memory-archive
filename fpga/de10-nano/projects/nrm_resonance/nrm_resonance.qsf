# =============================================================================
# Quartus Prime Project Settings - NRM Resonance Detector
# Target: DE10-Nano (Cyclone V 5CSEBA6U23I7)
# =============================================================================

# Device Assignment
set_global_assignment -name FAMILY "Cyclone V"
set_global_assignment -name DEVICE 5CSEBA6U23I7
set_global_assignment -name TOP_LEVEL_ENTITY nrm_system_wrapper
set_global_assignment -name ORIGINAL_QUARTUS_VERSION 24.1.0
set_global_assignment -name PROJECT_CREATION_TIME_DATE "2025-11-28"
set_global_assignment -name LAST_QUARTUS_VERSION "24.1std.0 Lite Edition"
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files

# Source Files
set_global_assignment -name VERILOG_FILE nrm_system_wrapper.v
set_global_assignment -name VERILOG_FILE nrm_resonance.v
set_global_assignment -name QIP_FILE jtag_system/synthesis/jtag_system.qip

# Compilation Settings
set_global_assignment -name MIN_CORE_JUNCTION_TEMP "-40"
set_global_assignment -name MAX_CORE_JUNCTION_TEMP 100
set_global_assignment -name ERROR_CHECK_FREQUENCY_DIVISOR 256

# Pin Assignments (DE10-Nano specific)
# Clock input (directly from FPGA oscillator)
set_location_assignment PIN_V11 -to clk
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to clk

# Active-low reset (directly from switch)
# Using KEY[0] on DE10-Nano
set_location_assignment PIN_AH17 -to rst_n
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to rst_n

# LED outputs (directly from FPGA pins)
# DE10-Nano has 8 user LEDs directly on FPGA fabric
set_location_assignment PIN_W15 -to led[0]
set_location_assignment PIN_AA24 -to led[1]
set_location_assignment PIN_V16 -to led[2]
set_location_assignment PIN_V15 -to led[3]
set_location_assignment PIN_AF26 -to led[4]
set_location_assignment PIN_AE26 -to led[5]
set_location_assignment PIN_Y16 -to led[6]
set_location_assignment PIN_AA23 -to led[7]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to led[*]

# Debug outputs (directly from FPGA GPIO header pins)
# Using Arduino header GPIO for debug
# set_location_assignment PIN_AG13 -to resonance_detected
# set_location_assignment PIN_AF13 -to heartbeat
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to resonance_detected
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to heartbeat

# Fuzzing Pins (Reverse Engineering)
# Arduino Header
set_location_assignment PIN_AG13 -to fuzz_out[0]
set_location_assignment PIN_AF13 -to fuzz_out[1]
set_location_assignment PIN_AG10 -to fuzz_out[2]
set_location_assignment PIN_AG9  -to fuzz_out[3]
set_location_assignment PIN_U14  -to fuzz_out[4]
set_location_assignment PIN_U13  -to fuzz_out[5]
set_location_assignment PIN_AG8  -to fuzz_out[6]
set_location_assignment PIN_AH8  -to fuzz_out[7]

# GPIO 0 Header (First 8 pins)
# set_location_assignment PIN_V12  -to fuzz_out[8]
# set_location_assignment PIN_E8   -to fuzz_out[9]
# set_location_assignment PIN_W12  -to fuzz_out[10]
# set_location_assignment PIN_D8   -to fuzz_out[11]
# set_location_assignment PIN_Y24  -to fuzz_out[12]
# set_location_assignment PIN_A7   -to fuzz_out[13]
# set_location_assignment PIN_AA26 -to fuzz_out[14]
# set_location_assignment PIN_W13  -to fuzz_out[15]

set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to fuzz_out[*]

# Timing Constraints
set_global_assignment -name SDC_FILE nrm_resonance.sdc
